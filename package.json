{
  "name": "ditz2",
  "version": "0.1.0",
  "description": "A distributed issue tracker whose issues are plain files in your repository",
  "license": "MIT",
  "author": "Tzvetan Mikov",
  "main": "./dist/api/index.js",
  "types": "./dist/api/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/api/index.d.ts",
      "default": "./dist/api/index.js"
    }
  },
  "type": "module",
  "bin": {
    "dz": "./dist/cli/main.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test:unit": "vitest run src",
    "test": "npm run build && vitest run"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "uuid": "^11.1.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ajv": "^8.20.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
